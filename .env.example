# Copy to .env and fill in. Never commit .env.

# --- Required for the live demo ---
ANTHROPIC_API_KEY=
# the Anthropic model ID (current Sonnet), from Anthropic's model list
LLM_MODEL=
AGENTVERSE_API_KEY=

# Agent seeds: set your OWN long random strings. Anyone who knows a seed controls that agent.
ORCHESTRATOR_SEED=
KNOWLEDGE_SEED=
ROUTING_SEED=
MANAGER_SEED=
INSIGHTS_SEED=
TRACKER_SEED=
CANARY_SEED=

# --- Manager approval gate ---
# The manager's ASI:One address(es), comma-separated. If empty, anyone can act as the manager (demo mode).
MANAGER_ALLOWED_SENDERS=
# Optional: push new approval requests to this address as a card.
MANAGER_CHAT_ADDRESS=

# --- Real email after approval (optional) ---
# Without SMTP, approved emails are saved to /outbox and the reply says "Simulated".
# Gmail: use an app password, host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Send every email to one inbox you control (recommended for the live demo).
DEMO_RECIPIENT_OVERRIDE=

# --- Payments ---
INSIGHTS_PRICE_FET=0.1
FET_USE_TESTNET=true

# --- Options ---
# anthropic (default) | gemini | snowflake | extractive (no model; quotes docs directly)
UNBLOCK_LLM=anthropic
# Pin "today" so doc freshness is repeatable in demos
UNBLOCK_TODAY=2026-10-17
UNBLOCK_CARDS=true

# --- Gemini (MLH: Best use of Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# gemini = hybrid retrieval (meaning + keywords). Leave empty for keywords only.
UNBLOCK_EMBEDDINGS=

# --- Snowflake Cortex (MLH: Snowflake REST API). Use with UNBLOCK_LLM=snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=llama3.1-70b

# --- Tiger Data (TimescaleDB) for Friction Map events ---
# Your Tiger Cloud service URL, e.g. postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIMESCALE_URL=

# --- Solana Pay (USDC) for the insights report ---
SOLANA_RECIPIENT=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_PRICE_USDC=0.5

# --- Web app, ElevenLabs voice tool, Vultr + GoDaddy ---
DOMAIN=
VOICE_TOOL_SECRET=
# ElevenLabs agent id (public), shows the voice widget on /app
ELEVENLABS_AGENT_ID=
WEB_RATE_PER_MIN=20

# --- Workday Build development tenant (new hire profile) ---
WORKDAY_HOST=
WORKDAY_TENANT=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_REFRESH_TOKEN=
WORKDAY_WORKER_SEARCH=mcneil
# Workday Agent-Ready MCP tools (read and act in Workday: absence, onboarding, journeys, learning...). See docs/WORKDAY.md.
WORKDAY_MCP_URL=
WORKDAY_MCP_TOKEN=
WORKDAY_MCP_TOKEN_URL=
WORKDAY_MCP_CLIENT_ID=
WORKDAY_MCP_CLIENT_SECRET=
WORKDAY_MCP_REFRESH_TOKEN=

# --- Canary New Hires ---
# How often the synthetic new hires walk the docs, and who may send their fixes (ASI:One addresses; empty = demo mode)
CANARY_INTERVAL_HOURS=24
CANARY_APPROVERS=

# --- Tracker (follow-ups) ---
TRACKER_DUE_HOURS=24
# For a live demo, offer the follow-up after a couple of minutes:
TRACKER_DUE_MINUTES=
TRACKER_CHECK_SECONDS=300

# Connect each agent's Agentverse mailbox automatically at startup
UNBLOCK_AUTO_CONNECT=true

# --- CREAO (Best Team Empowerment): the Doc Steward agent drafts doc fixes ---
# Agent ID from its page on agent.creao.ai, and that agent's capi_ key. Server-side only.
CREAO_APP_ID=
CREAO_API_KEY=
CREAO_CHECK_SECONDS=20
CREAO_TIMEOUT_MINUTES=12

# --- New Hire Portal (/app) ---
# If set, the Manager tab asks for this key before showing or deciding requests.
PORTAL_MANAGER_KEY=
